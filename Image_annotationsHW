import cv2
import matplotlib.pyplot as plt

image_path = 'Image_annotationsHW\example.jpg'
image = cv2.imread(image_path)
image_rgb = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
height, width, _ = image_rgb.shape
start_point_left = (0, height // 2)  
end_point_left = (width, height // 2)  
cv2.arrowedLine(image, start_point_left, (width - 50, height // 2), (0, 255, 0), 2, tipLength=0.05)  
cv2.arrowedLine(image, (width, height // 2), (50, height // 2), (0, 255, 0), 2, tipLength=0.05)
arrow_start = (width - 675, 20)  
arrow_end = (width - 675, height - 20) 
cv2.arrowedLine(image_rgb, arrow_start, arrow_end, (255, 255, 0), 3, tipLength=0.05)
cv2.arrowedLine(image_rgb, arrow_end, arrow_start, (255, 255, 0 ), 3, tipLength=0.05)
arrow_start2 = (width -  50, 20)  
arrow_end2 = (width - 50, height - 20) 
cv2.arrowedLine(image_rgb, arrow_start2, arrow_end2, (255, 255, 0), 3, tipLength=0.05)
cv2.arrowedLine(image_rgb, arrow_end2, arrow_start2, (255, 255, 0 ), 3, tipLength=0.05)
font = cv2.FONT_HERSHEY_SCRIPT_SIMPLEX
cv2.putText(image_rgb, 'Width' , (arrow_start), font, 1, (0,0, 255), 2, cv2.LINE_AA)
cv2.putText(image_rgb, 'Width' , (arrow_end2), font, 1, (0,0, 255), 2, cv2.LINE_AA)

plt.figure(figsize=(12, 8))
plt.imshow(image_rgb)
plt.title('Annotated image with Regions, Centers, and Bi-Directional Height Arrow')
plt.axis('off')
plt.show()
